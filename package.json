{
  "name": "freelance-place",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "node --experimental-transform-types --experimental-test-module-mocks --test tests/*.test.mjs",
    "test:security": "node --experimental-transform-types --experimental-test-module-mocks --test tests/security*.test.mjs tests/request-origin.test.mjs tests/proposal-withdrawal.test.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test:seo": "node --test tests/seo*.test.mjs",
    "test:billing": "node --experimental-transform-types --experimental-test-module-mocks --test tests/billing.test.mjs tests/membership-state.test.mjs tests/membership-policy.test.mjs tests/cardcom-deployment.test.mjs",
    "test:proposals": "node --test tests/proposals.test.mjs",
    "test:seed": "node --experimental-transform-types --test tests/seed-projects.test.mjs",
    "test:home": "node --test tests/home-render.test.mjs",
    "seed:projects": "node --experimental-transform-types scripts/seed-projects/seed-projects.ts --catalog scripts/seed-projects/catalog.he.json",
    "seo:indexnow": "node scripts/indexnow-submit.mjs"
  },
  "dependencies": {
    "@firebase/app": "0.14.9",
    "@firebase/auth": "1.12.1",
    "@google/genai": "^1.30.0",
    "@nangohq/frontend": "^0.72.3",
    "firebase-admin": "14.5.0",
    "google-auth-library": "^10.5.0",
    "next": "^16.2.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "@firebase/app": "0.14.9",
    "@firebase/app-compat": "0.5.9"
  }
}
