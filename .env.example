# Set these on the server runtime only. Authenticate locally with gcloud ADC.
GOOGLE_CLOUD_PROJECT=freelance-514118
NEXT_PUBLIC_SITE_URL=https://freelance-place.com
# Enable only on the public production deployment, never a preview.
SITE_INDEXABLE=false
# Optional search-console verification values; never invent tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# robots.txt policy for AI model-training crawlers (GPTBot, ClaudeBot, Google-Extended, CCBot, ...). allow (default) or disallow to opt out; search and user-triggered crawlers stay allowed.
AI_TRAINING_CRAWLERS=allow
# Optional IndexNow key override for key rotation; the key must also be served at /<key>.txt (add public/<key>.txt). Empty uses the built-in key.
INDEXNOW_KEY=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL_ID=gemini-3.8-flash
GOOGLE_GENAI_USE_ENTERPRISE=True

# Firebase web configuration is public client configuration, served at runtime.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
GOOGLE_SIGN_IN_ENABLED=false
UPLOADS_BUCKET=freelance-514118-user-uploads

# Nango API key stays in Google Secret Manager in production. These values are
# the integration IDs from the Nango dashboard, not credentials.
NANGO_GITHUB_INTEGRATION_ID=github
NANGO_LINKEDIN_INTEGRATION_ID=linkedin

# Fixed UTC cutoff: older Firebase accounts retain their existing access.
# Defaults to 2026-11-08T21:47:24Z. Set before rollout; never move it on restarts.
MEMBERSHIP_TRIAL_ROLLOUT_AT=2026-11-08T21:47:24Z

# Dribbble OAuth is handled directly by the server. Use a separate Dribbble
# OAuth app for localhost and production because each app has one callback URL.
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DRIBBBLE_REDIRECT_URI=http://localhost:3000/api/integrations/dribbble/callback

# Cardcom: enable after production secret mounts and the authenticated renewal scheduler are configured.
# Supply credentials using Secret Manager runtime mounts, never NEXT_PUBLIC_* variables.
BILLING_ENABLED=false
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
# Google-signed OIDC identity allowed to invoke the renewal endpoint.
BILLING_SCHEDULER_EMAIL=freelance-billing-scheduler@freelance-514118.iam.gserviceaccount.com

# Emergency switch: false stops new Vertex generation without affecting billing.
AI_GENERATION_ENABLED=true

# Customer support chat: server runtime only. Add secrets via Secret Manager.
# Full-access Resend key is required for both sending and receiving email bodies.
RESEND_API_KEY=
# Signing secret of the email.received webhook at /api/support/webhook.
RESEND_WEBHOOK_SECRET=
# Inbox you read/reply from. Defaults to the site's existing contact email.
SUPPORT_INBOX_EMAIL=customer@freelance-place.com
# Address on a domain verified for sending in Resend, e.g. Freelance Place <customer@freelance-place.com>.
SUPPORT_FROM_EMAIL=
# A separate receiving subdomain with Resend MX, e.g. chat.freelance-place.com.
# Do not replace the MX records of your normal inbox. No @ or URL here.
SUPPORT_REPLY_DOMAIN=
# Optional comma-separated additional email addresses allowed to reply as support.
SUPPORT_ALLOWED_REPLY_EMAILS=
# Optional kill switch for the automatic inbox acknowledgment: off|false|0|disabled. Unset = enabled.
SUPPORT_AUTOREPLY=

# Opt-in project mail. Reuses RESEND_API_KEY and falls back to SUPPORT_FROM_EMAIL.
PROJECT_NOTIFICATIONS_ENABLED=false
PROJECT_NOTIFICATIONS_FROM_EMAIL=
NOTIFICATIONS_SCHEDULER_EMAIL=

# XPlace import (profile source + project import for publishers). Off by default.
# XPLACE_IMPORT_ENABLED shows the XPlace UI and accepts data captured by the Freelance Place browser
# extension on the user's own XPlace pages. Enable it before the extension is published.
XPLACE_IMPORT_ENABLED=false
# Optional second switch: also let the server read a pasted public XPlace link (an automated fetch
# from our servers). Read the terms and privacy notes in docs/xplace-import.md before enabling it.
XPLACE_LINK_IMPORT_ENABLED=false
# Chrome Web Store URL of the extension, shown to users who do not have it yet. Empty hides the install prompt.
NEXT_PUBLIC_XPLACE_EXTENSION_URL=
