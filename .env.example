# Set these on the server runtime only. Authenticate locally with gcloud ADC.
GOOGLE_CLOUD_PROJECT=freelance-514118
NEXT_PUBLIC_SITE_URL=https://freelance-place.com
# Enable only on the public production deployment, never a preview.
SITE_INDEXABLE=false
# Optional search-console verification values; never invent tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# robots.txt policy for AI model-training crawlers (GPTBot, ClaudeBot, Google-Extended, CCBot, ...). allow (default) or disallow to opt out; search and user-triggered crawlers stay allowed.
AI_TRAINING_CRAWLERS=allow
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL_ID=gemini-3.8-flash
GOOGLE_GENAI_USE_ENTERPRISE=True

# Firebase web configuration is public client configuration, served at runtime.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_WEB_APP_ID=
GOOGLE_SIGN_IN_ENABLED=false
UPLOADS_BUCKET=freelance-514118-user-uploads

# Nango API key stays in Google Secret Manager in production. These values are
# the integration IDs from the Nango dashboard, not credentials.
NANGO_GITHUB_INTEGRATION_ID=github
NANGO_LINKEDIN_INTEGRATION_ID=linkedin

# Fixed UTC cutoff: older Firebase accounts retain their existing access.
# Defaults to 2026-11-08T21:47:24Z. Set before rollout; never move it on restarts.
MEMBERSHIP_TRIAL_ROLLOUT_AT=2026-11-08T21:47:24Z

# Dribbble OAuth is handled directly by the server. Use a separate Dribbble
# OAuth app for localhost and production because each app has one callback URL.
DRIBBBLE_CLIENT_ID=
DRIBBBLE_CLIENT_SECRET=
DRIBBBLE_REDIRECT_URI=http://localhost:3000/api/integrations/dribbble/callback

# Cardcom: enable after production secret mounts and the authenticated renewal scheduler are configured.
# Supply credentials using Secret Manager runtime mounts, never NEXT_PUBLIC_* variables.
BILLING_ENABLED=false
CARDCOM_TERMINAL_NUMBER=
CARDCOM_API_NAME=
CARDCOM_API_PASSWORD=
# Google-signed OIDC identity allowed to invoke the renewal endpoint.
BILLING_SCHEDULER_EMAIL=freelance-billing-scheduler@freelance-514118.iam.gserviceaccount.com
