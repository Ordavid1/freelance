# XPlace import flags. scripts/deploy-engine.sh sets these on every release. Terraform
# (infra/terraform/xplace-import.tf) declares the same defaults; keep both in step.
# XPLACE_EXTENSION_URL is the published Chrome Web Store listing (https only); empty hides the install prompt.
XPLACE_IMPORT_ENABLED=true
XPLACE_LINK_IMPORT_ENABLED=true
XPLACE_EXTENSION_URL=https://chromewebstore.google.com/detail/freelance-place-%E2%80%94-xplace/pmdpcogbhahimnbipapekgimgpkfnomn
